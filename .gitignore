# Build output
bin/
obj/
*.dll
*.pdb
*.exe

# VS / Rider
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Packages
# DllExport's package is restored by CI, but its "gcache" folder holds the configured
# meta assemblies (metacor/metalib DllExport.dll) that the imported targets reference
# for the DllExportAttribute. That folder is generated by DllExport's Configure/Restore
# wizard, which aborts on modern runners with "can't find any .sln file". It is only
# ~15 KB, so it is committed to keep the build reproducible without the wizard.
packages/*
!packages/DllExport.1.7.0-beta/
packages/DllExport.1.7.0-beta/*
!packages/DllExport.1.7.0-beta/gcache/
!packages/DllExport.1.7.0-beta/gcache/**
*.nupkg

# DllExport scratch
DllExportR.bat
DllExport.bat.lock
*.cache

# Test results
TestResults/
dvbapiNet.Tests/bin/
dvbapiNet.Tests/obj/

# Local config
*.local
*.env
update.cache.json

# Editor / agent state
.claude/
.vscode/

# Build artifact folders
DLL OK/
DLL backup/
backup/

# Markdown notes (internal)
RECONNECTION_IMPLEMENTATION.md
COMPILATION_GUIDE.md
BUILD.ps1
BUILD_DLL.bat
